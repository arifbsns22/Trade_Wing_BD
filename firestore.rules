rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Storefront & Catalog Data: Public read & write access (create, update, delete) for all app users
    match /products/{doc} { allow read, write: if true; }
    match /categories/{doc} { allow read, write: if true; }
    match /brands/{doc} { allow read, write: if true; }
    match /marketing_banners/{doc} { allow read, write: if true; }
    match /product_types/{doc} { allow read, write: if true; }
    match /units/{doc} { allow read, write: if true; }
    match /packages/{doc} { allow read, write: if true; }
    match /drive_packages/{doc} { allow read, write: if true; }
    match /operators/{doc} { allow read, write: if true; }
    match /settings/{doc} { allow read, write: if true; }
    match /product_reviews/{doc} { allow read, write: if true; }

    // User-specific Data & Operations
    match /users/{doc} { allow read, write: if true; }
    match /users/{doc}/{allPaths=**} { allow read, write: if true; }
    match /orders/{doc} { allow read, write: if true; }
    match /drive_orders/{doc} { allow read, write: if true; }
    match /recharges/{doc} { allow read, write: if true; }
    match /package_purchases/{doc} { allow read, write: if true; }
    match /trainings/{doc} { allow read, write: if true; }
    match /trainings/{doc}/{allPaths=**} { allow read, write: if true; }
    match /{path=**}/attendance/{doc} { allow read, write: if true; }

    // Permanent Global Fallback: Public read & write allowed
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


